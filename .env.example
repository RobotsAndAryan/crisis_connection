# Firebase Web App Configuration (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase App Check (Required for Firebase AI Logic)
# Set VITE_APP_CHECK_DEBUG_TOKEN=true for local development / hackathon testing
# (Chrome DevTools console prints the debug token UUID to register in Firebase Console)
# Or paste your pre-registered debug token UUID directly.
VITE_APP_CHECK_DEBUG_TOKEN=true
VITE_RECAPTCHA_SITE_KEY=

# Optional default Cloud Gemini model (also controllable live via Firebase Remote Config)
VITE_CLOUD_GEMINI_MODEL=gemini-2.5-flash
