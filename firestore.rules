rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Require Firebase Auth (including anonymous field worker sessions)
    match /aidCamps/{campId} {
      allow read, write: if request.auth != null;
    }
    match /fieldReports/{reportId} {
      allow read, write: if request.auth != null;
    }
    match /emergencyAlerts/{alertId} {
      allow read, write: if request.auth != null;
    }
    match /uncertaintyLogs/{logId} {
      allow read, write: if request.auth != null;
    }
    match /historyEvents/{eventId} {
      allow read, write: if request.auth != null;
    }
  }
}
